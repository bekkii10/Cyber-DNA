@import url("https://rsms.me/inter/inter.css");

:root {
  /* ===== TYPOGRAPHY TOKENS ===== */
  --font-ui: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-mono: "JetBrains Mono", "SF Mono", Consolas, monospace;

  /* ===== COLOR TOKENS (Cyber DNA — black/yellow) ===== */
  --bg-0: #050505;        /* page */
  --bg-1: #0a0a0a;        /* sidebar / topbar */
  --bg-2: #0d0d0d;        /* cards / panels */
  --bg-3: #141414;        /* hover / inputs */

  --border-0: #1c1c1c;    /* subtle */
  --border-1: #262626;    /* default */
  --border-2: #3a3a3a;    /* strong */

  --text-0: #ffffff;      /* headings */
  --text-1: #dddddd;      /* body */
  --text-2: #858585;      /* muted */
  --text-3: #5a5a5a;      /* disabled */

  --accent: #f5c400;      /* Cyber yellow */
  --accent-hover: #ffd633;
  --accent-soft: rgba(245, 196, 0, 0.08);

  --danger: #ef4444;
  --warning: #f59e0b;
  --success: #10b981;
  --info: #3b82f6;

  /* ===== SPACING (8px grid) ===== */
  --sp-1: 4px;  --sp-2: 8px;  --sp-3: 12px; --sp-4: 16px;
  --sp-5: 24px; --sp-6: 32px; --sp-7: 48px; --sp-8: 64px;

  /* ===== RADIUS ===== */
  --r-sm: 4px;
  --r-md: 6px;
  --r-lg: 8px;

  /* ===== SHADOWS ===== */
  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.25);
  --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.35);
  --shadow-accent: 0 0 24px rgba(245, 196, 0, 0.18);
}

* { box-sizing: border-box; }

html, body, #root { margin: 0; min-height: 100%; }

body {
  font-family: var(--font-ui);
  font-size: 14px;
  line-height: 1.5;
  letter-spacing: -0.011em;
  font-feature-settings: "cv11", "ss01";
  color: var(--text-1);
  background: var(--bg-0);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ===== TYPOGRAPHY SCALE (professional dashboard) ===== */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-ui);
  color: var(--text-0);
  margin: 0;
  letter-spacing: -0.02em;
}

/* Big KPI numbers */
.metric-value, .stat-value, .score, .risk-score, .profile-score b {
  font-variant-numeric: tabular-nums;
  font-weight: 700;
  letter-spacing: -0.03em;
}

/* Monospace for data */
.event-id, .ip-address, .badge, .status, th,
.eyebrow, .success, .failure, .muted {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
}

/* UI controls inherit Inter */
button, input, select, textarea { font-family: inherit; }
button { cursor: pointer; font-weight: 500; }
