/* =========================================================
   CYBER DNA — UNIFIED APP.CSS
   All colors come from tokens in index.css
   ========================================================= */

/* =========================================================
   1. APP SHELL
   ========================================================= */
.app {
  min-height: 100vh;
  display: flex;
  background: var(--bg-0);
  color: var(--text-1);
  font-family: var(--font-ui);
  position: relative;
  isolation: isolate;
}

/* =========================================================
   2. SIDEBAR
   ========================================================= */
.sidebar {
  width: var(--sidebar-width, 248px);
  flex: 0 0 var(--sidebar-width, 248px);
  min-width: 210px;
  background: var(--bg-1);
  border-right: 1px solid var(--border-0);
  display: flex;
  flex-direction: column;
  position: relative;
}

.sidebar-resizer {
  position: absolute;
  top: 0;
  right: -3px;
  width: 6px;
  height: 100%;
  cursor: col-resize;
  background: transparent;
  z-index: 8;
  touch-action: none;
}
.sidebar-resizer:hover,
.sidebar-resizer:active {
  background: var(--accent);
  opacity: 0.55;
}

.brand {
  height: 76px;
  padding: 0 var(--sp-4);
  display: flex;
  gap: 11px;
  align-items: center;
  border-bottom: 1px solid var(--border-0);
}
.brand-mark {
  width: 40px;
  height: 40px;
  border: 1px solid rgba(245, 196, 0, 0.35);
  background: var(--accent-soft);
  border-radius: var(--r-md);
  display: grid;
  place-items: center;
  color: var(--accent);
  position: relative;
  overflow: hidden;
}
.brand strong {
  display: block;
  font-size: 13px;
  letter-spacing: 1.6px;
  color: var(--text-0);
}
.brand strong em {
  font-style: normal;
  color: var(--accent);
}
.brand span {
  display: block;
  margin-top: 2px;
  font: 500 9px var(--font-mono);
  color: var(--text-2);
  letter-spacing: 1px;
}

.env {
  margin: var(--sp-4) var(--sp-3) var(--sp-2);
  padding: 10px 12px;
  background: var(--bg-2);
  border: 1px solid var(--border-0);
  border-radius: var(--r-sm);
}
.env span {
  display: flex;
  gap: 7px;
  align-items: center;
  font: 600 9px var(--font-mono);
  color: var(--accent);
  letter-spacing: 0.6px;
}
.env i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 8px rgba(245, 196, 0, 0.6);
}
.env small {
  display: block;
  margin-top: 6px;
  color: var(--text-2);
  font: 9px var(--font-mono);
}

nav {
  padding: var(--sp-2);
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.nav {
  border: 0;
  background: transparent;
  color: var(--text-2);
  text-align: left;
  padding: 10px 12px;
  display: flex;
  align-items: center;
  gap: 11px;
  border-radius: var(--r-sm);
  font-size: 12px;
  font-weight: 500;
  transition: background 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
}
.nav:hover {
  background: var(--bg-3);
  color: var(--text-0);
}
.nav.active {
  background: var(--accent-soft);
  color: var(--accent);
  box-shadow: inset 2px 0 0 var(--accent);
}
.nav b {
  margin-left: auto;
  background: rgba(239, 68, 68, 0.18);
  color: #ffb4ba;
  font: 600 9px var(--font-mono);
  padding: 2px 6px;
  border-radius: 9px;
  min-width: 18px;
  text-align: center;
}

.sidebar-bottom {
  margin-top: auto;
  border-top: 1px solid var(--border-0);
  padding: var(--sp-3);
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.sidebar-bottom div {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--text-2);
  font-size: 10px;
  padding: 6px 4px;
}
.sidebar-bottom strong {
  margin-left: auto;
  color: var(--accent);
  font: 600 9px var(--font-mono);
}

.settings-nav {
  width: 100%;
  border: 1px solid transparent;
  background: transparent;
  color: var(--text-2);
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 9px 6px;
  border-radius: var(--r-sm);
  font-size: 11px;
  font-weight: 500;
  transition: background 0.15s ease, color 0.15s ease;
  margin-top: 4px;
}
.settings-nav:hover {
  background: var(--bg-3);
  color: var(--text-0);
}
.settings-nav svg:last-child {
  margin-left: auto;
}

/* =========================================================
   3. TOPBAR
   ========================================================= */
.main {
  flex: 1;
  min-width: 0;
}
.topbar {
  height: 68px;
  border-bottom: 1px solid var(--border-0);
  background: var(--bg-1);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--sp-6);
  position: sticky;
  top: 0;
  z-index: 5;
}
.eyebrow {
  font: 600 10px var(--font-mono);
  color: var(--text-2);
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.logout-button {
  display: flex;
  align-items: center;
  gap: 8px;
  height: 36px;
  padding: 0 var(--sp-3);
  border: 1px solid var(--border-1);
  background: var(--bg-2);
  color: var(--text-1);
  border-radius: var(--r-sm);
  font: 700 11px var(--font-mono);
  letter-spacing: 0.6px;
  transition: all 0.16s ease;
}
.logout-button svg {
  color: var(--accent);
}
.logout-button:hover {
  border-color: var(--accent);
  background: var(--accent-soft);
  color: var(--text-0);
}

/* =========================================================
   4. CONTENT + STATS
   ========================================================= */
.content {
  padding: var(--sp-5) var(--sp-6) var(--sp-7);
  max-width: 1680px;
}
.page-stack {
  display: flex;
  flex-direction: column;
  gap: var(--sp-5);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: var(--sp-3);
}
.stat-card {
  background: var(--bg-2);
  border: 1px solid var(--border-0);
  border-radius: var(--r-lg);
  padding: var(--sp-4);
  min-height: 112px;
  transition: border-color 0.18s ease, transform 0.18s ease;
}
.stat-card:hover {
  border-color: rgba(245, 196, 0, 0.28);
  transform: translateY(-2px);
}
.stat-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--text-2);
  font: 600 10px var(--font-mono);
  letter-spacing: 0.8px;
  text-transform: uppercase;
}
.stat-top svg {
  color: var(--accent);
  opacity: 0.7;
}
.stat-value {
  font-size: 28px;
  font-weight: 700;
  letter-spacing: -0.03em;
  color: var(--text-0);
  margin-top: var(--sp-3);
  font-variant-numeric: tabular-nums;
}
.stat-value.warning { color: var(--warning); }
.stat-value.danger  { color: var(--danger); }
.stat-note {
  font: 500 10px var(--font-mono);
  color: var(--text-2);
  margin-top: 6px;
}

/* =========================================================
   5. PANELS
   ========================================================= */
.panel {
  background: var(--bg-2);
  border: 1px solid var(--border-0);
  border-radius: var(--r-lg);
  overflow: hidden;
}
.panel-head {
  height: 52px;
  border-bottom: 1px solid var(--border-0);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--sp-4);
}
.panel-title {
  display: flex;
  align-items: center;
  gap: 9px;
  color: var(--text-0);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.2px;
}
.panel-title svg { color: var(--accent); }
.muted {
  color: var(--text-2) !important;
  font-size: 11px;
}

.two-col {
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  gap: var(--sp-5);
}

.live-pill,
.model-status {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--accent);
  font: 600 9px var(--font-mono);
  letter-spacing: 0.8px;
}
.live-pill i,
.model-status i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 8px rgba(245, 196, 0, 0.6);
  animation: statusPulse 1.4s ease-in-out infinite;
}

/* =========================================================
   6. CHART (bar graph)
   ========================================================= */
.chart-wrap {
  height: 250px;
  padding: var(--sp-4) var(--sp-4) var(--sp-3);
  position: relative;
}
.bar-chart {
  height: 174px;
  margin-left: 30px;
  display: flex;
  align-items: stretch;
  gap: 3px;
  border-bottom: 1px solid var(--border-0);
  padding: 6px 3px 0;
  position: relative;
  background: repeating-linear-gradient(
    to bottom,
    transparent 0 34px,
    rgba(255, 255, 255, 0.03) 34px 35px
  );
}
.bar-col {
  flex: 1;
  min-width: 5px;
  height: 100%;
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.bar-track {
  height: 150px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.bar-fill {
  width: 72%;
  min-height: 2px;
  background: var(--accent);
  border-radius: 2px 2px 0 0;
  transition: height 0.25s ease, background 0.15s ease;
}
.bar-fill:hover { background: var(--accent-hover); }
.bar-col > span {
  position: absolute;
  bottom: -16px;
  left: 50%;
  transform: translateX(-50%);
  font: 8px var(--font-mono);
  color: var(--text-3);
}
.chart-labels {
  position: absolute;
  left: 7px;
  top: 22px;
  height: 150px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  font: 8px var(--font-mono);
  color: var(--text-3);
}
.chart-foot {
  display: flex;
  justify-content: space-between;
  margin: 22px 2px 0;
  color: var(--text-2);
  font: 9px var(--font-mono);
}
.chart-foot b { color: var(--text-0); }

/* =========================================================
   7. DONUT (risk distribution)
   ========================================================= */
.risk-donut {
  height: 250px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-5);
  padding: var(--sp-4);
}
.donut {
  width: 130px;
  height: 130px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: conic-gradient(
    var(--danger) 0 25%,
    var(--warning) 25% 58%,
    var(--info) 58% 83%,
    var(--text-3) 83% 100%
  );
  position: relative;
}
.donut:after {
  content: "";
  position: absolute;
  width: 94px;
  height: 94px;
  background: var(--bg-2);
  border-radius: 50%;
}
.donut div {
  position: relative;
  z-index: 1;
  text-align: center;
}
.donut strong {
  display: block;
  font-size: 26px;
  font-weight: 700;
  color: var(--text-0);
  letter-spacing: -0.02em;
}
.donut span {
  font: 9px var(--font-mono);
  color: var(--text-2);
}
.legend { min-width: 110px; }
.legend div {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 0;
  color: var(--text-1);
  font-size: 11px;
}
.legend b {
  margin-left: auto;
  color: var(--text-0);
  font-weight: 600;
}
.dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
}
.dot.critical { background: var(--danger); }
.dot.high     { background: var(--warning); }
.dot.medium   { background: var(--info); }
.dot.low      { background: var(--success); }

/* =========================================================
   8. BADGES
   ========================================================= */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border: 1px solid var(--border-1);
  background: var(--bg-3);
  padding: 3px 8px;
  border-radius: 4px;
  font: 600 9px var(--font-mono);
  letter-spacing: 0.6px;
  text-transform: uppercase;
  color: var(--text-1);
}
.badge:before {
  content: "";
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: currentColor;
}
.badge.critical { border-color: rgba(239, 68, 68, 0.4); color: #ff8585; }
.badge.high     { border-color: rgba(245, 158, 11, 0.4); color: #fbbf24; }
.badge.medium   { border-color: rgba(59, 130, 246, 0.4); color: #60a5fa; }
.badge.low      { border-color: rgba(16, 185, 129, 0.4); color: #34d399; }

/* =========================================================
   9. TABLES
   ========================================================= */
.table-scroll {
  overflow: auto;
}
table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
  text-align: left;
}
th {
  padding: 11px 14px;
  color: var(--text-2);
  font: 600 9px var(--font-mono);
  letter-spacing: 1px;
  border-bottom: 1px solid var(--border-0);
  white-space: nowrap;
  text-transform: uppercase;
}
td {
  padding: 11px 14px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  color: var(--text-1);
  vertical-align: middle;
  white-space: nowrap;
}
tbody tr {
  transition: background 0.14s ease;
}
tbody tr:hover {
  background: var(--bg-3);
}
.event-id {
  color: var(--accent);
  font: 500 11px var(--font-mono);
}
.success {
  color: var(--success);
  font: 600 10px var(--font-mono);
}
.failure {
  color: var(--danger);
  font: 600 10px var(--font-mono);
}
td small {
  display: block;
  max-width: 280px;
  overflow: hidden;
  text-overflow: ellipsis;
  color: var(--text-2);
  margin-top: 4px;
}
.clickable { cursor: pointer; }
.score { font: 700 12px var(--font-mono); }
.score.critical { color: #ff8585; }
.score.high     { color: #fbbf24; }
.score.medium   { color: #60a5fa; }
.score.low      { color: #34d399; }

/* =========================================================
   10. ALERT LIST
   ========================================================= */
.alert-list { padding: 4px 0; }
.alert-row {
  width: 100%;
  border: 0;
  background: transparent;
  padding: 12px 16px;
  display: grid;
  grid-template-columns: auto 1fr auto auto;
  gap: 12px;
  align-items: center;
  text-align: left;
  color: var(--text-1);
  transition: background 0.14s ease;
}
.alert-row:hover { background: var(--bg-3); }
.alert-row strong {
  display: block;
  font-size: 11px;
  color: var(--text-0);
}
.alert-row small {
  display: block;
  color: var(--text-2);
  margin-top: 3px;
  font: 10px var(--font-mono);
}
.alert-row b {
  font: 600 12px var(--font-mono);
  color: var(--accent);
}

/* =========================================================
   11. TOOLBAR + FILTERS + SEARCH
   ========================================================= */
.toolbar {
  display: flex;
  justify-content: space-between;
  gap: var(--sp-3);
  padding: var(--sp-3) var(--sp-4);
  border-bottom: 1px solid var(--border-0);
  flex-wrap: wrap;
}
.filters {
  display: flex;
  gap: 5px;
  flex-wrap: wrap;
}
.filter {
  border: 1px solid var(--border-1);
  background: var(--bg-2);
  color: var(--text-2);
  border-radius: var(--r-sm);
  padding: 6px 10px;
  font: 600 9px var(--font-mono);
  letter-spacing: 0.6px;
  transition: all 0.15s ease;
}
.filter:hover {
  border-color: var(--border-2);
  color: var(--text-0);
}
.filter.active {
  background: var(--accent-soft);
  border-color: var(--accent);
  color: var(--accent);
}
.search {
  min-width: 230px;
  display: flex;
  align-items: center;
  gap: 7px;
  border: 1px solid var(--border-1);
  background: var(--bg-0);
  border-radius: var(--r-sm);
  padding: 0 10px;
  color: var(--text-2);
  transition: border-color 0.15s ease;
}
.search:focus-within { border-color: var(--accent); }
.search input {
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--text-0);
  font-size: 11px;
  padding: 9px 0;
  width: 100%;
}

/* =========================================================
   12. INCIDENTS
   ========================================================= */
.incident-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--sp-3);
  padding: var(--sp-4);
}
.incident-card {
  border: 1px solid var(--border-0);
  background: var(--bg-2);
  border-radius: var(--r-md);
  text-align: left;
  padding: var(--sp-4);
  color: var(--text-1);
  transition: border-color 0.18s ease, transform 0.18s ease;
}
.incident-card:hover {
  border-color: rgba(245, 196, 0, 0.3);
  transform: translateY(-2px);
}
.incident-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font: 600 9px var(--font-mono);
  color: var(--text-2);
  letter-spacing: 0.6px;
}
.incident-card h3 {
  font-size: 13px;
  color: var(--text-0);
  margin: var(--sp-4) 0 6px;
  font-weight: 600;
  letter-spacing: -0.01em;
}
.incident-card p {
  font: 10px var(--font-mono);
  color: var(--text-2);
  margin: 0;
}
.chain {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 5px;
  margin: var(--sp-4) 0;
}
.chain span {
  padding: 5px 7px;
  background: var(--bg-3);
  border: 1px solid var(--border-1);
  border-radius: 4px;
  font: 500 9px var(--font-mono);
  color: var(--text-1);
}
.chain svg { color: var(--text-3); }
.incident-meta {
  border-top: 1px solid var(--border-0);
  padding-top: var(--sp-3);
  display: flex;
  gap: var(--sp-4);
  font: 10px var(--font-mono);
  color: var(--text-2);
}
.incident-meta strong {
  margin-left: auto;
  color: var(--accent);
  font-weight: 600;
}

/* =========================================================
   13. INFO BANNERS
   ========================================================= */
.info-banner,
.architecture-note,
.explain {
  margin: var(--sp-4);
  padding: var(--sp-3) var(--sp-4);
  border: 1px solid rgba(245, 196, 0, 0.15);
  background: var(--accent-soft);
  border-radius: var(--r-md);
  display: flex;
  gap: 11px;
  color: var(--accent);
}
.info-banner strong,
.architecture-note strong,
.explain strong {
  color: var(--text-0);
  font-size: 11px;
  display: block;
  letter-spacing: 0.2px;
}
.info-banner p,
.architecture-note p,
.explain p {
  margin: 5px 0 0;
  color: var(--text-1);
  font-size: 11px;
  line-height: 1.6;
}

/* =========================================================
   14. USERS
   ========================================================= */
.user-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--sp-3);
  padding: var(--sp-4);
}
.user-card {
  border: 1px solid var(--border-0);
  background: var(--bg-2);
  border-radius: var(--r-md);
  text-align: left;
  padding: var(--sp-4);
  color: var(--text-1);
  position: relative;
  transition: border-color 0.18s ease, transform 0.18s ease;
}
.user-card:hover {
  border-color: rgba(245, 196, 0, 0.3);
  transform: translateY(-2px);
}
.user-avatar,
.big-avatar {
  width: 38px;
  height: 38px;
  border: 1px solid rgba(245, 196, 0, 0.35);
  background: var(--accent-soft);
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: var(--accent);
}
.user-main {
  position: absolute;
  left: 64px;
  top: 18px;
}
.user-main strong {
  display: block;
  font-size: 12px;
  color: var(--text-0);
}
.user-main span {
  font-size: 10px;
  color: var(--text-2);
}
.risk-score {
  margin: var(--sp-5) 0 var(--sp-2);
  text-align: right;
}
.risk-score strong {
  font: 700 26px var(--font-mono);
  color: var(--accent);
  letter-spacing: -0.02em;
}
.risk-score small {
  display: block;
  font: 9px var(--font-mono);
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: 0.8px;
}
.meter {
  height: 4px;
  background: var(--bg-3);
  border-radius: 4px;
  overflow: hidden;
  margin-bottom: 10px;
}
.meter i {
  display: block;
  height: 100%;
  background: linear-gradient(90deg, var(--success), var(--warning), var(--danger));
  border-radius: 4px;
}

/* =========================================================
   15. HOSTS
   ========================================================= */
.host-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--sp-3);
  padding: var(--sp-4);
}
.host-card {
  padding: var(--sp-4);
  border: 1px solid var(--border-0);
  background: var(--bg-2);
  border-radius: var(--r-md);
  transition: border-color 0.18s ease, transform 0.18s ease;
}
.host-card:hover {
  border-color: rgba(245, 196, 0, 0.3);
  transform: translateY(-2px);
}
.host-icon {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(245, 196, 0, 0.3);
  border-radius: var(--r-sm);
  color: var(--accent);
  background: var(--accent-soft);
  float: left;
  margin-right: 11px;
}
.host-card strong {
  display: block;
  font-size: 12px;
  color: var(--text-0);
  padding-top: 4px;
}
.host-card > div:nth-child(2) span {
  display: block;
  font: 9px var(--font-mono);
  color: var(--text-2);
  margin-top: 4px;
}
.host-card > .badge {
  display: inline-flex;
  margin-top: 10px;
}
.host-bottom {
  clear: both;
  border-top: 1px solid var(--border-0);
  margin-top: var(--sp-4);
  padding-top: var(--sp-3);
  display: flex;
  justify-content: space-between;
  font: 10px var(--font-mono);
  color: var(--text-2);
}
.host-bottom b {
  color: var(--accent);
  font-weight: 700;
}
.enabled {
  color: var(--success);
  font: 600 9px var(--font-mono);
  letter-spacing: 0.6px;
}
.disabled {
  color: var(--text-3);
  font: 600 9px var(--font-mono);
  letter-spacing: 0.6px;
}

/* =========================================================
   16. PIPELINE
   ========================================================= */
.pipeline {
  display: flex;
  align-items: stretch;
  gap: var(--sp-2);
  padding: var(--sp-5) var(--sp-4);
}
.pipe-step {
  flex: 1;
  min-height: 130px;
  border: 1px solid var(--border-0);
  background: var(--bg-2);
  border-radius: var(--r-md);
  padding: var(--sp-4);
}
.pipe-step > span {
  font: 600 9px var(--font-mono);
  color: var(--text-3);
  letter-spacing: 1px;
}
.pipe-step strong {
  display: block;
  color: var(--text-0);
  font-size: 12px;
  margin-top: var(--sp-3);
  letter-spacing: -0.01em;
}
.pipe-step b {
  display: block;
  color: var(--accent);
  font: 600 10px var(--font-mono);
  margin-top: 5px;
}
.pipe-step small {
  display: block;
  color: var(--text-2);
  font-size: 10px;
  line-height: 1.5;
  margin-top: 10px;
}
.pipe-arrow {
  align-self: center;
  color: var(--text-3);
  flex: none;
}

/* =========================================================
   17. MODAL
   ========================================================= */
.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(6px);
  display: grid;
  place-items: center;
  z-index: 20;
  padding: var(--sp-5);
  animation: fadeIn 0.16s ease;
}
.modal {
  width: min(680px, 96vw);
  max-height: 88vh;
  overflow: auto;
  background: var(--bg-2);
  border: 1px solid var(--border-1);
  border-radius: var(--r-lg);
  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.6);
  animation: scaleIn 0.18s ease;
}
.modal-head {
  height: 56px;
  border-bottom: 1px solid var(--border-0);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--sp-4);
}
.modal-head span {
  display: flex;
  align-items: center;
  gap: 9px;
  color: var(--text-0);
  font-size: 13px;
  font-weight: 600;
}
.modal-head svg { color: var(--accent); }
.modal-head button {
  border: 0;
  background: transparent;
  color: var(--text-2);
  padding: 6px;
  border-radius: 4px;
  transition: all 0.14s ease;
}
.modal-head button:hover {
  background: var(--bg-3);
  color: var(--text-0);
}
.modal-risk,
.incident-modal-head {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: var(--sp-4);
  border-bottom: 1px solid var(--border-0);
}
.modal-risk > strong,
.incident-modal-head > strong {
  font-size: 13px;
  color: var(--text-0);
}
.modal-risk > span {
  margin-left: auto;
  color: var(--text-2);
  font-size: 10px;
}
.modal-risk b {
  color: var(--accent);
  font: 700 13px var(--font-mono);
}
.modal-detail {
  padding: var(--sp-4);
  margin: 0;
  color: var(--text-1);
  font-size: 12px;
  line-height: 1.65;
}
.evidence-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--border-0);
  margin: 0 var(--sp-4);
  border-radius: var(--r-sm);
  overflow: hidden;
}
.evidence-grid div {
  background: var(--bg-2);
  padding: var(--sp-3);
}
.evidence-grid span,
.mini-stats span {
  display: block;
  color: var(--text-2);
  font: 9px var(--font-mono);
  text-transform: uppercase;
  letter-spacing: 0.8px;
}
.evidence-grid b {
  display: block;
  color: var(--text-0);
  font: 11px var(--font-mono);
  margin-top: 6px;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* =========================================================
   18. PROFILE / MINI STATS
   ========================================================= */
.profile {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-5);
}
.profile h2 {
  font-size: 18px;
  margin: 0 0 4px;
  color: var(--text-0);
  letter-spacing: -0.02em;
}
.profile span {
  font-size: 10px;
  color: var(--text-2);
  font-family: var(--font-mono);
}
.profile-score {
  margin-left: auto;
  text-align: right;
}
.profile-score b {
  display: block;
  font: 700 28px var(--font-mono);
  color: var(--accent);
  letter-spacing: -0.02em;
}
.profile-score span {
  font: 9px var(--font-mono);
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: 0.8px;
}
.mini-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--border-0);
  margin: 0 var(--sp-4) var(--sp-4);
  border-radius: var(--r-sm);
  overflow: hidden;
}
.mini-stats div {
  padding: var(--sp-3);
  background: var(--bg-2);
}
.mini-stats b {
  display: block;
  color: var(--text-0);
  font: 12px var(--font-mono);
  margin-top: 6px;
  font-weight: 600;
}

/*
/* =========================================================
   19. LOGIN / STARTUP SCREEN
   ========================================================= */
.startup-screen {
  min-height: 100vh;
  width: 100%;
  position: relative;
  overflow: hidden;
  display: grid;
  place-items: center;
  background:
    radial-gradient(circle at 50% 30%, rgba(245, 196, 0, 0.07), transparent 42%),
    var(--bg-0);
  color: var(--text-1);
  font-family: var(--font-ui);
}

.startup-grid {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(245, 196, 0, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(245, 196, 0, 0.035) 1px, transparent 1px);
  background-size: 48px 48px;
  mask-image: radial-gradient(circle at center, black 0 45%, transparent 80%);
  -webkit-mask-image: radial-gradient(circle at center, black 0 45%, transparent 80%);
}

.flag-glow {
  position: absolute;
  width: 520px;
  height: 520px;
  left: 50%;
  top: 40%;
  transform: translate(-50%, -50%);
  background: radial-gradient(circle, rgba(245, 196, 0, 0.12), transparent 65%);
  filter: blur(20px);
  pointer-events: none;
}

.startup-content {
  position: relative;
  z-index: 3;
  width: min(440px, calc(100% - 40px));
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  animation: fadeUp 0.5s ease both;
}

/* Logo */
.startup-logo-wrap {
  width: 120px;
  height: 120px;
  margin-bottom: var(--sp-5);
  position: relative;
  display: grid;
  place-items: center;
}
.startup-logo {
  width: 78px;
  height: 78px;
  border: 1.5px solid var(--accent);
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: var(--accent);
  background: rgba(0, 0, 0, 0.75);
  box-shadow:
    0 0 30px rgba(245, 196, 0, 0.22),
    inset 0 0 20px rgba(245, 196, 0, 0.08);
  position: relative;
}
.startup-logo span {
  position: absolute;
  bottom: 8px;
  right: 9px;
  font: 700 9px var(--font-mono);
  letter-spacing: 1px;
  color: var(--text-0);
}

.startup-ring {
  position: absolute;
  border: 1px solid rgba(245, 196, 0, 0.3);
  border-radius: 50%;
  pointer-events: none;
}
.ring-one {
  width: 100px;
  height: 100px;
  animation: pulseRing 2.4s ease-in-out infinite;
}
.ring-two {
  width: 120px;
  height: 120px;
  border-color: rgba(245, 196, 0, 0.12);
  animation: pulseRing 2.4s ease-in-out infinite 0.6s;
}

/* Heading */
.startup-kicker {
  font: 700 10px var(--font-mono);
  letter-spacing: 3px;
  color: var(--accent);
  margin-bottom: var(--sp-3);
}
.startup-content h1 {
  font-size: clamp(38px, 6vw, 56px);
  font-weight: 800;
  letter-spacing: 4px;
  line-height: 1;
  margin: 0 0 var(--sp-3);
  color: var(--text-0);
}
.startup-content h1 span { color: var(--accent); }
.startup-content > p {
  font-size: 13px;
  color: var(--text-2);
  margin: 0 0 var(--sp-5);
  letter-spacing: 0.3px;
}

/* Status bar */
.startup-status {
  width: 100%;
  padding: 10px 14px;
  margin-bottom: var(--sp-4);
  border: 1px solid rgba(245, 196, 0, 0.15);
  background: rgba(255, 255, 255, 0.02);
  border-radius: var(--r-sm);
  color: var(--text-2);
  font: 700 10px var(--font-mono);
  letter-spacing: 1.3px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  box-sizing: border-box;
}
.startup-status i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 10px rgba(245, 196, 0, 0.7);
  animation: statusPulse 1.4s ease-in-out infinite;
}

/* Login form */
.login-form {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  margin-bottom: var(--sp-4);
  text-align: left;
}
.login-field { width: 100%; }

.login-field-label {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 7px;
  font: 700 10px var(--font-mono);
  letter-spacing: 1.4px;
  color: var(--text-1);
}
.login-field-label svg { color: var(--accent); }

.startup-login-input {
  width: 100%;
  height: 48px;
  padding: 0 var(--sp-4);
  border: 1px solid var(--border-1);
  border-radius: var(--r-md);
  background: rgba(255, 255, 255, 0.03);
  color: var(--text-0);
  font-size: 14px;
  font-family: var(--font-ui);
  outline: none;
  box-sizing: border-box;
  transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
}
.startup-login-input::placeholder { color: var(--text-3); }
.startup-login-input:hover { border-color: var(--border-2); }
.startup-login-input:focus {
  border-color: var(--accent);
  background: var(--accent-soft);
  box-shadow: 0 0 0 3px rgba(245, 196, 0, 0.08);
}

.password-wrapper { position: relative; width: 100%; }
.password-wrapper .startup-login-input { padding-right: 48px; }
.password-toggle {
  position: absolute;
  right: 0;
  top: 0;
  width: 46px;
  height: 48px;
  display: grid;
  place-items: center;
  border: 0;
  background: transparent;
  color: var(--text-2);
  border-radius: 0 var(--r-md) var(--r-md) 0;
  transition: color 0.15s ease;
}
.password-toggle:hover { color: var(--accent); }
.password-toggle:disabled { opacity: 0.5; cursor: not-allowed; }

.login-error {
  padding: var(--sp-3);
  border: 1px solid rgba(239, 68, 68, 0.35);
  border-left: 3px solid var(--danger);
  background: rgba(239, 68, 68, 0.07);
  color: #ff9a9a;
  font-size: 12px;
  border-radius: var(--r-sm);
  box-sizing: border-box;
}

/* Start button */
.start-button {
  width: 100%;
  height: 48px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 0 var(--sp-5);
  border: 1px solid var(--accent);
  border-radius: var(--r-md);
  background: var(--accent);
  color: #050505;
  font: 800 12px var(--font-ui);
  letter-spacing: 1.2px;
  cursor: pointer;
  transition: all 0.18s ease;
  box-sizing: border-box;
}
.start-button:hover:not(:disabled) {
  background: var(--accent-hover);
  box-shadow: 0 8px 30px rgba(245, 196, 0, 0.2);
  transform: translateY(-1px);
}
.start-button:active:not(:disabled) { transform: translateY(0); }
.start-button:disabled {
  opacity: 0.6;
  cursor: wait;
  transform: none;
}

.start-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Footer meta */
.startup-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-top: var(--sp-4);
  color: var(--text-3);
  font: 700 9px var(--font-mono);
  letter-spacing: 1.3px;
}

.startup-corner {
  position: absolute;
  z-index: 3;
  color: var(--text-3);
  font: 700 9px var(--font-mono);
  letter-spacing: 1.5px;
}
.startup-corner.top-left { top: 24px; left: 28px; }
.startup-corner.bottom-right { right: 28px; bottom: 24px; }

/* Booting state */
.startup-screen.booting .startup-logo {
  box-shadow:
    0 0 40px rgba(245, 196, 0, 0.4),
    inset 0 0 25px rgba(245, 196, 0, 0.12);
}

.spin {
  animation: spin 1s linear infinite;
}

/* =========================================================
   20. ANIMATIONS
   ========================================================= */
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.96); }
  to   { opacity: 1; transform: scale(1); }
}
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: none; }
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
@keyframes statusPulse {
  0%, 100% { opacity: 0.4; }
  50%      { opacity: 1; }
}
@keyframes pulseRing {
  0%, 100% { transform: scale(0.94); opacity: 0.35; }
  50%      { transform: scale(1.04); opacity: 0.85; }
}

/* =========================================================
   21. RESPONSIVE
   ========================================================= */
@media (max-width: 1100px) {
  .stats-grid { grid-template-columns: repeat(3, 1fr); }
  .two-col { grid-template-columns: 1fr; }
  .user-grid,
  .host-grid { grid-template-columns: repeat(2, 1fr); }
  .incident-grid { grid-template-columns: 1fr; }
  .pipeline { flex-wrap: wrap; }
  .pipe-step { min-width: 220px; }
  .pipe-arrow { display: none; }
}

@media (max-width: 760px) {
  .sidebar {
    width: 64px;
    flex-basis: 64px;
    min-width: 64px;
  }
  .sidebar-resizer { display: none; }
  .brand > div:last-child,
  .env,
  .nav span,
  .nav b,
  .sidebar-bottom span,
  .sidebar-bottom strong,
  .logout-button span { display: none; }
  .nav { justify-content: center; }
  .topbar { padding: 0 var(--sp-4); }
  .content { padding: var(--sp-4); }
  .stats-grid { grid-template-columns: repeat(2, 1fr); }
  .user-grid,
  .host-grid { grid-template-columns: 1fr; }
  .toolbar { flex-direction: column; }
  .search { width: 100%; min-width: 0; }
  .evidence-grid { grid-template-columns: 1fr 1fr; }
  .startup-content h1 { font-size: 34px; letter-spacing: 3px; }
  .startup-logo-wrap { transform: scale(0.9); margin-bottom: 12px; }
  .startup-meta { flex-wrap: wrap; }
  .startup-corner { display: none; }
}

/* =========================================================
   22. REDUCE MOTION (accessibility)
   ========================================================= */
.reduce-motion *,
.reduce-motion *:before,
.reduce-motion *:after {
  animation-duration: 0.001ms !important;
  animation-iteration-count: 1 !important;
  transition-duration: 0.001ms !important;
}
